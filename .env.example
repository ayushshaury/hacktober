# Frontend (Vite) - exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[ANON_OR_PUBLISHABLE_KEY]

# Backend (set these in Vercel -> Project -> Settings -> Environment Variables)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# JWT_SECRET=super_long_random_string
# NODE_ENV=production
