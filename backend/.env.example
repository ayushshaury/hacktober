PORT=5000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=bit_sindri_clubs

# Alternatively, configure a connection URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bit_sindri_clubs

# ---- Supabase (production / Vercel) ----
# Supabase Dashboard -> Connect -> Connection string -> URI  (use the POOLER, port 6543)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# SUPABASE_DB_URL=           # alias, read if DATABASE_URL is missing
# SUPABASE_URL=              # https://[PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=         # anon / publishable key
# DB_SSL=true
# DB_POOL_MAX=1              # kept low for serverless
# JWT_SECRET=change_me_on_vercel
